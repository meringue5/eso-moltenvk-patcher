#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h:h}"
PAYLOAD="$ROOT/payload"
PACKAGE_CHECKSUMS="$ROOT/SHA256SUMS.txt"
if [[ ! -f "$PACKAGE_CHECKSUMS" ]] ||
   ! (cd "$ROOT" && shasum -a 256 -c "${PACKAGE_CHECKSUMS:t}" >/dev/null 2>&1); then
  print -u2 -- "ESO MoltenVK Patcher package checksum verification failed."
  print -u2 -- "Download a fresh release package; no files were changed."
  exit 1
fi
source "$PAYLOAD/target-profile.env"
source "$PAYLOAD/settings-profile.env"

UI_TTY=false
[[ -t 1 ]] && UI_TTY=true
UI_GREEN="" UI_RED="" UI_BLUE="" UI_DIM="" UI_BRIGHT="" UI_GREY="" UI_RESET=""
if [[ "$UI_TTY" == true && -z "${NO_COLOR:-}" ]]; then
  UI_GREEN=$'\033[32m'
  UI_RED=$'\033[31m'
  UI_BLUE=$'\033[36m'
  UI_DIM=$'\033[2m'
  UI_BRIGHT=$'\033[1m'
  UI_GREY=$'\033[90m'
  UI_RESET=$'\033[0m'
fi
MUTATION_STARTED=false
INSTALL_ALREADY_CURRENT=false
RECOVERY_GENERATION_REBASE=false
RECOVERY_REBASE_SUFFIX=""
RECORDED_EXECUTABLE_SHA256=""
RECORDED_ORIGINAL_BINK_SHA256=""
REMOVE_RESTORE_ACTION="none"
PATCH_UPGRADE=false
PREVIOUS_SETTINGS_CHOICE=""
PREVIOUS_SETTINGS_BACKUP=""
PREVIOUS_SETTINGS_PROFILE=""
RETAIN_PREVIOUS_SETTINGS_RECORD=false
UI_ACTION=""
UI_COMPLETED=0
typeset -a UI_STEP_LABELS

ui_clear() {
  if [[ "$UI_TTY" == true ]]; then
    printf '\033[2J\033[H'
  fi
  return 0
}

ui_header() {
  local action="$1"
  print -- ""
  print -- "╭──────────────────────────────────────────────╮"
  printf '│  %-44s│\n' "ESO MoltenVK Patcher ${RELEASE_VERSION:-unknown}"
  printf '│  %-44s│\n' "$action"
  print -- "╰──────────────────────────────────────────────╯"
  print -- ""
}

ui_step() {
  local current="$1" total="$2" label="$3" result="${4:-Done}"
  if [[ "$UI_TTY" == true && -n "$UI_ACTION" ]]; then
    UI_COMPLETED="$current"
    ui_render_plan
    return 0
  fi
  local symbol="✓" color="$UI_GREEN"
  [[ "$result" == "Skipped" ]] && { symbol="–"; color="$UI_DIM"; }
  print -- "  ${color}${symbol}${UI_RESET} [$current/$total] $label  ${color}$result${UI_RESET}"
}

ui_render_plan() {
  ui_clear
  ui_header "$UI_ACTION"
  local step total="${#UI_STEP_LABELS[@]}"
  for (( step = 1; step <= total; step++ )); do
    if (( step <= UI_COMPLETED )); then
      print -- "  ${UI_GREEN}☑${UI_RESET} ${UI_BRIGHT}[$step/$total] ${UI_STEP_LABELS[$step]}${UI_RESET}"
    else
      print -- "    ${UI_GREY}[$step/$total] ${UI_STEP_LABELS[$step]}${UI_RESET}"
    fi
  done
  print -- ""
}

ui_plan_start() {
  UI_ACTION="$1"
  shift
  UI_STEP_LABELS=("$@")
  UI_COMPLETED=0
  if [[ "$UI_TTY" == true ]]; then
    ui_render_plan
  else
    ui_header "$UI_ACTION"
  fi
}

ui_choice_menu() {
  local title="$1" detail="$2" yes_label="$3" no_label="$4"
  local selected=1 key="" sequence=""
  while true; do
    ui_render_plan
    print -- "  $title"
    [[ -n "$detail" ]] && print -- "  $detail"
    print -- ""
    if (( selected == 1 )); then
      print -- "  ${UI_GREEN}›${UI_RESET} ${UI_BRIGHT}$yes_label${UI_RESET}"
    else
      print -- "    $yes_label"
    fi
    if (( selected == 2 )); then
      print -- "  ${UI_GREEN}›${UI_RESET} ${UI_BRIGHT}$no_label${UI_RESET}"
    else
      print -- "    $no_label"
    fi
    print -- ""
    print -- "  ${UI_DIM}Use ↑/↓ and Return, or press Y/N. Esc cancels.${UI_RESET}"
    if ! IFS= read -rsk1 key; then
      return 1
    fi
    case "$key" in
      y|Y) return 0 ;;
      n|N) return 1 ;;
      $'\n'|$'\r')
        (( selected == 1 )) && return 0
        (( selected == 2 )) && return 1
        printf '\a'
        ;;
      $'\e')
        sequence=""
        IFS= read -rsk2 -t 0.2 sequence || true
        case "$sequence" in
          '[A'|'[B') selected=$(( selected == 1 ? 2 : 1 )) ;;
          *) return 1 ;;
        esac
        ;;
      *) printf '\a' ;;
    esac
  done
}

ui_complete() {
  print -- ""
  print -- "${UI_GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 100%${UI_RESET}"
  print -- ""
  print -- "${UI_GREEN}✓ $1${UI_RESET}"
}

die() {
  print -u2 -- ""
  print -u2 -- "${UI_RED}✗ Operation stopped safely${UI_RESET}"
  print -u2 -- ""
  print -u2 -- "  $*"
  if [[ "$MUTATION_STARTED" == false ]]; then
    [[ "$*" == *"No files were changed."* ]] || print -u2 -- "  No files were changed."
  else
    print -u2 -- "  A verified recovery record is available; run the command again."
  fi
  exit 1
}
sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

state_value() {
  local key="$1" file="$2"
  sed -n "s/^${key}=//p" "$file" | head -1
}

marker_mode_value() {
  local value=""
  [[ -f "$MARKER" ]] || return 1
  value="$(state_value mode "$MARKER")"
  if [[ -n "$value" ]]; then
    print -r -- "$value"
  else
    head -1 "$MARKER"
  fi
}

usage() {
  cat <<'EOF'
Usage: eso-moltenvk-patcher <status|diagnose|install|remove|repair> [options]

Install options:
  --apply-settings       selectively merge the bundled M4 settings template
  --skip-settings        leave UserSettings.txt unchanged
  --settings-file PATH   select UserSettings.txt when applying the template
  --yes                  accept the displayed ESO application target

Diagnostics options:
  --output PATH          write the privacy-filtered support ZIP to PATH

PATH may be eso.app itself or an ESO Launcher.app containing game_mac.
No game, Steam, or launcher is started by this tool.
EOF
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 2; }
shift || true
selected="${ESO_APP:-}"
selected_settings="${ESO_SETTINGS_FILE:-}"
assume_yes=false
settings_choice=""
support_output=""
PRODUCTION_LOG="${ESO_MOLTENVK_PATCHER_LOG_PATH:-$HOME/Library/Logs/ESO MoltenVK Patcher/bridge.log}"
while (( $# )); do
  case "$1" in
    --eso-app) (( $# >= 2 )) || die "--eso-app needs a path"; selected="$2"; shift 2 ;;
    --settings-file) (( $# >= 2 )) || die "--settings-file needs a path"; selected_settings="$2"; shift 2 ;;
    --apply-settings) [[ -z "$settings_choice" ]] || die "Choose only one settings action."; settings_choice=apply; shift ;;
    --skip-settings) [[ -z "$settings_choice" ]] || die "Choose only one settings action."; settings_choice=skip; shift ;;
    --yes|-y) assume_yes=true; shift ;;
    --output) (( $# >= 2 )) || die "--output needs a path"; support_output="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown argument: $1" ;;
  esac
done
[[ -z "$support_output" || "$command_name" == diagnose ]] \
  || die "--output is available only with diagnose."
[[ -z "$settings_choice" || "$command_name" == install || "$command_name" == repair ]] \
  || die "Settings options are available only with install or repair."

resolve_target() {
  local home_dir="$HOME"
  local -a candidates=(
    "$home_dir/Library/Application Support/Steam/steamapps/common/Zenimax Online/The Elder Scrolls Online/game_mac/pubplayerclient/eso.app"
    "/Applications/ZeniMax Online/Launcher.app/game_mac/pubplayerclient/eso.app"
  )
  if [[ -z "$selected" ]]; then
    local candidate
    for candidate in "${candidates[@]}"; do
      [[ -d "$candidate" ]] && { selected="$candidate"; break; }
    done
  fi
  if [[ -z "$selected" && -t 0 ]]; then
    print -- "ESO was not found in a known location."
    print -- "Drag eso.app or the ESO Launcher.app into this Terminal window, then press Return:"
    IFS= read -r selected
    selected="${(Q)selected}"
  fi
  [[ -n "$selected" ]] || die "ESO was not found. Re-run with --eso-app '/path/to/eso.app'."
  if [[ "${selected:t}" == "eso.app" ]]; then
    ESO_APP="${selected:A}"
  else
    ESO_APP="${selected:A}/game_mac/pubplayerclient/eso.app"
  fi
  GAME_MAC="$ESO_APP/Contents/MacOS"
  ESO="$GAME_MAC/eso"
  BINK="$GAME_MAC/libBink2Macx64.dylib"
  MARKER="$GAME_MAC/.teso4m4-enable"
  RENAMED="$GAME_MAC/libBink2Macx64.teso4m4-original.dylib"
  MVK="$GAME_MAC/libMoltenVK.teso4m4.dylib"
  LEGACY_MVK="$ESO_APP/Contents/Frameworks/MoltenVK.framework/Versions/A/MoltenVK"
  COMPAT_AUDIT="$PAYLOAD/eso-compat-audit"
  [[ -f "$ESO" && -f "$BINK" ]] || die "This path does not contain an ESO macOS client."
}

state_directory() {
  local id
  id="$(print -rn -- "$ESO_APP" | shasum -a 256 | awk '{print $1}')"
  local state_root="${ESO_MOLTENVK_PATCHER_STATE_ROOT:-$HOME/Library/Application Support/ESO MoltenVK Patcher/Installations}"
  STATE_DIR="$state_root/$id"
  BACKUP="$STATE_DIR/original-libBink2Macx64.dylib"
  STATE="$STATE_DIR/install-state.env"
  VERSION_FILE="$STATE_DIR/.version"
  SETTINGS_PATH_FILE="$STATE_DIR/settings-target-path.txt"
  SETTINGS_APPLIED_SHA_FILE="$STATE_DIR/settings-applied.sha256"
}

choose_settings_action() {
  [[ "$command_name" == install || "$command_name" == repair ]] || return 0
  if [[ -n "$settings_choice" ]]; then return 0; fi
  [[ -t 0 ]] || die "Choose settings explicitly with --apply-settings or --skip-settings."
  if ui_choice_menu \
    "Settings profile" \
    "Balanced M4 1920 x 1200 profile; Apply is selected by default." \
    "Apply 48 allowlisted settings" \
    "Keep my current settings"; then
    settings_choice=apply
  else
    settings_choice=skip
  fi
}

resolve_settings_file() {
  [[ "$settings_choice" == apply ]] || return 0
  local home_dir="$HOME"
  local -a candidates=(
    "$home_dir/Documents/Elder Scrolls Online/live/UserSettings.txt"
    "$home_dir/Library/Mobile Documents/com~apple~CloudDocs/Documents/Elder Scrolls Online/live/UserSettings.txt"
  )
  if [[ -z "$selected_settings" ]]; then
    local candidate
    for candidate in "${candidates[@]}"; do
      [[ -f "$candidate" ]] && { selected_settings="$candidate"; break; }
    done
  fi
  if [[ -z "$selected_settings" && -t 0 ]]; then
    print -- "UserSettings.txt was not found in a known location."
    print -- "Drag UserSettings.txt into this Terminal window, then press Return:"
    IFS= read -r selected_settings
    selected_settings="${(Q)selected_settings}"
  fi
  [[ -n "$selected_settings" ]] || die "UserSettings.txt was not found. Re-run with --settings-file PATH."
  SETTINGS_FILE="${selected_settings:A}"
  [[ -f "$SETTINGS_FILE" ]] || die "The selected settings path is not a regular file: $SETTINGS_FILE"
  [[ "$SETTINGS_PROFILE_SCHEMA" == 1 \
    && "$SETTINGS_PROFILE_ID" == balanced-m4-1920x1200-v1 \
    && "$SETTINGS_PROFILE_FILE" == usersettings-m4-moltenvk-1.4.2-standard.txt \
    && "$SETTINGS_PROFILE_KEY_COUNT" == 48 ]] \
    || die "The settings profile metadata is not supported by this release."
  [[ -f "$PAYLOAD/$SETTINGS_PROFILE_FILE" ]] || die "The settings template is missing from this release."
}

validate_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local template="$PAYLOAD/$SETTINGS_PROFILE_FILE"
  local count unique
  count="$(awk '$1 == "SET" {count++} END {print count + 0}' "$template")"
  unique="$(awk '$1 == "SET" {seen[$2] = 1} END {for (key in seen) count++; print count + 0}' "$template")"
  [[ "$count" == "$SETTINGS_PROFILE_KEY_COUNT" \
    && "$unique" == "$SETTINGS_PROFILE_KEY_COUNT" ]] \
    || die "The bundled settings template is not the expected $SETTINGS_PROFILE_KEY_COUNT-key profile."
}

prepare_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local template="$PAYLOAD/$SETTINGS_PROFILE_FILE"
  local backup temporary
  backup="$(mktemp "$STATE_DIR/settings-backup-XXXXXXXX")"
  temporary="$STATE_DIR/settings-merged.txt"
  copy_verified "$SETTINGS_FILE" "$backup"
  awk '
    NR == FNR {
      if ($1 == "SET") { replacement[$2] = $0; order[++count] = $2 }
      next
    }
    {
      if ($1 == "SET" && ($2 in replacement)) {
        print replacement[$2]
        applied[$2] = 1
      } else print
    }
    END {
      for (item_index = 1; item_index <= count; item_index++) {
        key = order[item_index]
        if (!(key in applied)) print replacement[key]
      }
    }
  ' "$template" "$SETTINGS_FILE" > "$temporary"
  if ! awk '$1 == "SET" {seen[$2]++} END {for (key in seen) if (seen[key] != 1) exit 1}' "$temporary"; then
    rm -f "$temporary"
    die "The merged settings file contains duplicate keys."
  fi
  print -r -- "$SETTINGS_FILE" > "$SETTINGS_PATH_FILE"
  rm -f "$SETTINGS_APPLIED_SHA_FILE"
  SETTINGS_BACKUP_NAME="${backup:t}"
}

commit_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local merged="$STATE_DIR/settings-merged.txt"
  [[ -f "$merged" ]] || die "The prepared settings merge is missing."
  copy_verified "$merged" "$SETTINGS_FILE"
  print -r -- "$(sha256 "$SETTINGS_FILE")" > "$SETTINGS_APPLIED_SHA_FILE"
  rm -f "$merged"
}

restore_settings_if_safe() {
  [[ "${settings_choice:-skip}" == apply ]] || return 0
  [[ -f "$SETTINGS_APPLIED_SHA_FILE" ]] || return 0
  [[ -f "$SETTINGS_PATH_FILE" && -n "${settings_backup:-}" ]] \
    || { print -- "Settings restore record is incomplete; settings were not changed."; return 0; }
  local settings_file backup applied_sha
  settings_file="$(<"$SETTINGS_PATH_FILE")"
  backup="$STATE_DIR/$settings_backup"
  applied_sha="$(<"$SETTINGS_APPLIED_SHA_FILE")"
  [[ -f "$settings_file" && -f "$backup" ]] || { print -- "Settings file or backup is missing; settings were not changed."; return 0; }
  if [[ "$(sha256 "$settings_file")" != "$applied_sha" ]]; then
    print -- "Settings changed after installation; they were not overwritten. Backup retained at: $backup"
    return 0
  fi
  copy_verified "$backup" "$settings_file"
  print -- "Restored pre-install settings from: $backup"
}

require_supported_original() {
  [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "The Bink library is not the exact original expected by this release. No files were changed."
}

active_loader_kind() {
  local dependencies
  dependencies="$(otool -L "$BINK" 2>/dev/null)" \
    || die "The active Bink library could not be classified. No files were changed."
  if [[ "$dependencies" == *"libBink2Macx64.teso4m4-original.dylib"*"reexport"* ]]; then
    print -- bridge
  else
    print -- non-bridge
  fi
}

load_verified_recovery_record() {
  [[ -f "$BACKUP" && -f "$STATE" ]] \
    || die "A complete verified recovery record was not found. No files were changed."
  RECORDED_EXECUTABLE_SHA256="$(state_value executable_sha256 "$STATE")"
  RECORDED_ORIGINAL_BINK_SHA256="$(state_value original_bink_sha256 "$STATE")"
  [[ -n "$RECORDED_EXECUTABLE_SHA256" \
    && -n "$RECORDED_ORIGINAL_BINK_SHA256" \
    && "$(sha256 "$BACKUP")" == "$RECORDED_ORIGINAL_BINK_SHA256" ]] \
    || die "The recovery record and its original-loader backup do not match. No files were changed."
}

archive_previous_recovery_generation() {
  [[ "$RECOVERY_GENERATION_REBASE" == true ]] || return 0
  load_verified_recovery_record
  local suffix="$RECOVERY_REBASE_SUFFIX"
  local archived_backup="$STATE_DIR/original-libBink2Macx64.before-${suffix}.dylib"
  local archived_state="$STATE_DIR/install-state.before-${suffix}.env"
  if [[ -e "$archived_backup" ]]; then
    [[ -f "$archived_backup" \
      && "$(sha256 "$archived_backup")" == "$(sha256 "$BACKUP")" ]] \
      || die "The archived original-loader generation conflicts with the verified backup. No files were changed."
  else
    copy_verified "$BACKUP" "$archived_backup"
  fi
  if [[ -e "$archived_state" ]]; then
    [[ -f "$archived_state" && "$(sha256 "$archived_state")" == "$(sha256 "$STATE")" ]] \
      || die "The archived recovery state conflicts with the current verified record. No files were changed."
  else
    copy_verified "$STATE" "$archived_state"
  fi
  if [[ -f "$MARKER" ]]; then
    local archived_marker="$STATE_DIR/enable-marker.before-${suffix}"
    if [[ -e "$archived_marker" ]]; then
      [[ -f "$archived_marker" && "$(sha256 "$archived_marker")" == "$(sha256 "$MARKER")" ]] \
        || die "The archived enable marker conflicts with the current marker. No files were changed."
    else
      copy_verified "$MARKER" "$archived_marker"
    fi
  fi
  rm -f "$BACKUP" "$STATE"
  print -- "  Preserved the previous original-loader generation: ${archived_backup:t}"
}

require_supported_executable() {
  ACTUAL_ESO_SHA256="$(sha256 "$ESO")"
  TARGET_COMPATIBILITY=exact
  if [[ "$ACTUAL_ESO_SHA256" == "$EXPECTED_ESO_SHA256" ]]; then
    return 0
  fi
  [[ -f "$LEGACY_MVK" ]] || die "The embedded MoltenVK archive is missing. No files were changed."
  [[ "$(sha256 "$LEGACY_MVK")" == "$EXPECTED_LEGACY_MVK_ARCHIVE_SHA256" ]] \
    || die "ESO's embedded MoltenVK changed. No files were changed."
  [[ -x "$COMPAT_AUDIT" ]] || die "The compatibility auditor is missing from this release. No files were changed."
  "$COMPAT_AUDIT" "$ESO" >/dev/null 2>&1 \
    || die "ESO's MoltenVK call layout changed. No files were changed."
  TARGET_COMPATIBILITY=compatible-update
  print -- "  Compatible ESO update detected; the MoltenVK bridge profile is unchanged."
}

require_idle() {
  pgrep -x eso >/dev/null 2>&1 && die "Quit ESO before changing its files."
  pgrep -f '/ZeniMax Online Studios Launcher' >/dev/null 2>&1 && die "Quit the ZeniMax launcher before changing ESO files."
  command -v lsof >/dev/null 2>&1 || die "lsof is required to check that the ESO bundle is idle."
  local open_files="" lsof_status=0
  open_files="$(lsof -Fn +D "$ESO_APP" 2>/dev/null)" || lsof_status=$?
  [[ -z "$open_files" && "$lsof_status" -eq 1 ]] || die "A process is using this ESO bundle, or its idle state could not be verified."
  local marker="/steamapps/common/"
  [[ "$ESO_APP" == *"$marker"* ]] || return 0
  local steamapps="${ESO_APP%%$marker*}/steamapps"
  local manifest="$steamapps/appmanifest_306130.acf"
  [[ -f "$manifest" ]] || return 0
  local flags total done
  flags="$(awk -F'"' '$2 == "StateFlags" {print $4; exit}' "$manifest")"
  total="$(awk -F'"' '$2 == "BytesToDownload" {print $4; exit}' "$manifest")"
  done="$(awk -F'"' '$2 == "BytesDownloaded" {print $4; exit}' "$manifest")"
  [[ "$flags" == "4" && -n "$total" && "$total" == "$done" ]] || die "Steam reports ESO as updating or incomplete."
  [[ ! -d "$steamapps/downloading/306130" || -z "$(find "$steamapps/downloading/306130" -mindepth 1 -print -quit 2>/dev/null)" ]] || die "Steam has staged ESO download content."
}

write_command() {
  local directory="$1"
  shift
  if [[ -w "$directory" ]]; then "$@"; else sudo "$@"; fi
}

copy_verified() {
  local source="$1" destination="$2" temporary="${2}.eso-moltenvk-patcher-installing"
  write_command "${temporary:h}" rm -f "$temporary"
  write_command "${temporary:h}" cp -p "$source" "$temporary"
  [[ "$(sha256 "$source")" == "$(sha256 "$temporary")" ]] || die "Copy verification failed for ${destination:t}."
  write_command "${destination:h}" rm -f "$destination"
  write_command "${destination:h}" mv "$temporary" "$destination"
}

retag_original() {
  write_command "${RENAMED:h}" /usr/bin/install_name_tool -id \
    '@loader_path/libBink2Macx64.teso4m4-original.dylib' "$RENAMED"
}

record_state() {
  local phase="$1"
  local recorded_settings_choice="${settings_choice:-skip}"
  local recorded_settings_backup="${SETTINGS_BACKUP_NAME:-${settings_backup:-}}"
  local recorded_settings_profile=""
  [[ "$recorded_settings_choice" == apply ]] \
    && recorded_settings_profile="$SETTINGS_PROFILE_ID"
  if [[ "$RETAIN_PREVIOUS_SETTINGS_RECORD" == true ]]; then
    recorded_settings_choice=apply
    recorded_settings_backup="$PREVIOUS_SETTINGS_BACKUP"
    recorded_settings_profile="$PREVIOUS_SETTINGS_PROFILE"
  fi
  print -r -- "executable_sha256=${ACTUAL_ESO_SHA256:-$(sha256 "$ESO")}" > "$STATE"
  print -r -- "profile_sha256=$EXPECTED_ESO_SHA256" >> "$STATE"
  print -r -- "original_bink_sha256=$EXPECTED_ORIGINAL_BINK_SHA256" >> "$STATE"
  print -r -- "bridge_sha256=$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" >> "$STATE"
  print -r -- "moltenvk_sha256=$(sha256 "$PAYLOAD/libMoltenVK.teso4m4.dylib")" >> "$STATE"
  print -r -- "active_bink_sha256=$(sha256 "$BINK")" >> "$STATE"
  print -r -- "remove_restore_action=${REMOVE_RESTORE_ACTION:-none}" >> "$STATE"
  print -r -- "release_version=${RELEASE_VERSION:-unknown}" >> "$STATE"
  print -r -- "transaction_phase=$phase" >> "$STATE"
  print -r -- "settings_choice=$recorded_settings_choice" >> "$STATE"
  print -r -- "settings_backup=$recorded_settings_backup" >> "$STATE"
  print -r -- "settings_profile=$recorded_settings_profile" >> "$STATE"
  print -r -- "recorded_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$STATE"
  print -r -- "${RELEASE_VERSION:-unknown}" > "$VERSION_FILE"
}

preserve_previous_state() {
  [[ -f "$STATE" ]] || return 0
  local recorded_sha
  recorded_sha="$(sed -n 's/^executable_sha256=//p' "$STATE" | head -1)"
  [[ -n "$recorded_sha" && "$recorded_sha" != "$ACTUAL_ESO_SHA256" ]] || return 0
  local archived="$STATE_DIR/install-state.before-${recorded_sha[1,12]}.env"
  [[ -e "$archived" ]] || copy_verified "$STATE" "$archived"
  if [[ -f "$MARKER" ]]; then
    local marker_archive="$STATE_DIR/enable-marker.before-${recorded_sha[1,12]}"
    [[ -e "$marker_archive" ]] || copy_verified "$MARKER" "$marker_archive"
  fi
}

recover_incomplete_install() {
  local current_bink="$(sha256 "$BINK")"
  local payload_bink="$(sha256 "$PAYLOAD/libBink2Macx64.dylib")"
  if [[ -e "$MARKER" && "$current_bink" == "$payload_bink" ]]; then
    load_verified_recovery_record
    [[ "$RECORDED_ORIGINAL_BINK_SHA256" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
      || die "The installed bridge belongs to an older original-loader generation. Run the ESO launcher Repair first; no files were changed."
    if [[ "$RECORDED_EXECUTABLE_SHA256" == "$ACTUAL_ESO_SHA256" ]]; then
      local marker_sha installed_version
      marker_sha="$(state_value eso_sha256 "$MARKER")"
      installed_version=""
      [[ -f "$VERSION_FILE" ]] && installed_version="$(<"$VERSION_FILE")"
      if [[ "$marker_sha" == "$ACTUAL_ESO_SHA256" \
        && "$installed_version" == "${RELEASE_VERSION:-unknown}" ]]; then
        INSTALL_ALREADY_CURRENT=true
        return 0
      fi
      PATCH_UPGRADE=true
      PREVIOUS_SETTINGS_CHOICE="$(state_value settings_choice "$STATE")"
      PREVIOUS_SETTINGS_BACKUP="$(state_value settings_backup "$STATE")"
      PREVIOUS_SETTINGS_PROFILE="$(state_value settings_profile "$STATE")"
      print -- "  The verified bridge payload belongs to an earlier package state; it will be re-attested in place."
      return 0
    fi
    die "ESO was updated while the bridge loader remained active. Run the ESO launcher Repair to materialize the current original Bink library, then run Install again. The previous backup was not restored. No files were changed."
  fi
  if [[ -e "$MARKER" && "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
    if [[ -e "$BACKUP" || -e "$STATE" ]]; then
      load_verified_recovery_record
      if [[ "$RECORDED_ORIGINAL_BINK_SHA256" != "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
        RECOVERY_GENERATION_REBASE=true
        RECOVERY_REBASE_SUFFIX="${RECORDED_EXECUTABLE_SHA256[1,12]}-${RECORDED_ORIGINAL_BINK_SHA256[1,12]}"
        print -- "  A newly supported original Bink generation is active; the previous recovery generation will be preserved."
      fi
    fi
    print -- "  Detected an ESO update that restored the original loader; preserving recovery state."
    return 0
  fi
  if [[ -e "$MARKER" ]]; then
    if [[ "$(active_loader_kind)" == bridge ]]; then
      load_verified_recovery_record
      local marker_sha
      marker_sha="$(state_value eso_sha256 "$MARKER")"
      if [[ "$RECORDED_EXECUTABLE_SHA256" == "$ACTUAL_ESO_SHA256" \
        && "$RECORDED_ORIGINAL_BINK_SHA256" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
        && ( "$marker_sha" == "$ACTUAL_ESO_SHA256" \
          || ( -z "$marker_sha" && "$ACTUAL_ESO_SHA256" == "$EXPECTED_ESO_SHA256" \
            && "$(marker_mode_value || true)" == startup-compositor-neutralize-pacing-release ) ) ]]; then
        PATCH_UPGRADE=true
        PREVIOUS_SETTINGS_CHOICE="$(state_value settings_choice "$STATE")"
        PREVIOUS_SETTINGS_BACKUP="$(state_value settings_backup "$STATE")"
        PREVIOUS_SETTINGS_PROFILE="$(state_value settings_profile "$STATE")"
        print -- "  Detected a verified earlier patcher on the same ESO and original-loader generation; it will be upgraded in place."
        return 0
      fi
      die "An unrecognized bridge loader is active after an ESO update. Run the ESO launcher Repair before installing. No files were changed."
    fi
    die "ESO installed a different original Bink library. This patcher release does not support that loader generation; the existing backup was not restored. Install a newer compatible patcher. No files were changed."
  fi
  if [[ "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
    && ( -e "$BACKUP" || -e "$STATE" ) ]]; then
    load_verified_recovery_record
    if [[ "$RECORDED_ORIGINAL_BINK_SHA256" != "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
      RECOVERY_GENERATION_REBASE=true
      RECOVERY_REBASE_SUFFIX="${RECORDED_EXECUTABLE_SHA256[1,12]}-${RECORDED_ORIGINAL_BINK_SHA256[1,12]}"
      print -- "  A newly supported original Bink generation is active; the previous recovery generation will be preserved."
      return 0
    fi
  fi
  if [[ ! -e "$RENAMED" && ! -e "$MVK" && "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
    return 0
  fi
  if [[ "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" && ! -e "$STATE" && ! -e "$BACKUP" ]]; then
    [[ ! -e "$RENAMED" || "$(sha256 "$RENAMED")" == "$EXPECTED_RETAGGED_ORIGINAL_BINK_SHA256" ]] \
      || die "An unknown inactive Bink companion file is present. No files were changed."
    [[ ! -e "$MVK" || "$(sha256 "$MVK")" == "$(sha256 "$PAYLOAD/libMoltenVK.teso4m4.dylib")" ]] \
      || die "An unknown inactive MoltenVK companion file is present. No files were changed."
    print -- "  Detected verified inactive development artifacts; the active original baseline is clean."
    return 0
  fi
  [[ -f "$BACKUP" && -f "$STATE" ]] || die "An incomplete patch state exists without a verified restore record. No files were changed."
  local requested_settings_choice="$settings_choice"
  source "$STATE"
  [[ "${executable_sha256:-}" == "${ACTUAL_ESO_SHA256:-$(sha256 "$ESO")}" \
    && "${original_bink_sha256:-}" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
    && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
    || die "The incomplete patch state does not match this exact client. No files were changed."
  [[ "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
    || "$current_bink" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]] \
    || die "The active Bink library is neither the verified original nor this release's bridge. No files were changed."
  print -- "A previous install stopped during phase: ${transaction_phase:-unknown}."
  print -- "Restoring the verified baseline before restarting installation."
  copy_verified "$BACKUP" "$BINK"
  write_command "$GAME_MAC" rm -f "$RENAMED" "$MVK" "$MARKER"
  restore_settings_if_safe
  rm -f "$STATE_DIR/settings-merged.txt" "$SETTINGS_APPLIED_SHA_FILE"
  settings_choice="$requested_settings_choice"
  SETTINGS_BACKUP_NAME=""
  record_state recovered
}

latest_run_id() {
  [[ -f "$PRODUCTION_LOG" ]] || return 1
  sed -n 's/^\[run=\([^]]*\)\].*/\1/p' "$PRODUCTION_LOG" | tail -1
}

print_latest_run_summary() {
  local run_id="" run_lines="" problems=0 initial_state="not recorded"
  run_id="$(latest_run_id || true)"
  if [[ -z "$run_id" ]]; then
    print -- "Last launch: not available"
    return 0
  fi
  run_lines="$(grep -F "[run=$run_id]" "$PRODUCTION_LOG" || true)"
  [[ "$run_lines" == *"MODE: startup compositor neutralize pacing release enabled"* ]] || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"MOLTENVK_CONFIG: live_resources=0 metal_argument_buffers=0 use_mtlheap=1 synchronous_queue_submits=0 command_pooling=1 prefill=0 maximize_concurrent_compilation=0"* ]] \
    || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"ACTIVE: redirected 17 Vulkan entry points"* ]] || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"ESO SHA-256: $ACTUAL_ESO_SHA256"* ]] || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"INACTIVE_PACING_ACTIVE: inactive_100ms_sleep=bypassed"* ]] || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"STARTUP_COMPOSITOR_NEUTRALIZE_LATCH: action=forward"*"ordinal=150"*"suppressed_draws=79"* ]] || problems=$(( problems + 1 ))
  [[ "$run_lines" == *"STARTUP_COLOR_AUDIT_FINISH:"*"ordinal=180"* ]] || problems=$(( problems + 1 ))
  if print -r -- "$run_lines" | grep -Eq '\] (ERROR:|FATAL:|SKIP:|[^ ]+_ERROR:)'; then
    problems=$(( problems + 1 ))
  fi
  local first_state
  first_state="$(print -r -- "$run_lines" | grep 'INACTIVE_PACING_STATE:' | head -1 || true)"
  if [[ "$first_state" == *"active=yes"* ]]; then
    initial_state="active=yes (observed)"
  elif [[ "$first_state" == *"active=no"* ]]; then
    initial_state="active=no, 100-ms sleep bypassed (observed)"
  fi
  if (( problems == 0 )); then
    print -- "Last launch: PASS"
  else
    print -- "Last launch: REVIEW ($problems invariant checks failed)"
  fi
  print -- "  Run: $run_id"
  print -- "  Initial activity: $initial_state"
  print -- "  Startup control: 79 suppressed, ordinal 150 forwarded, ordinal 180 finished"
  print -- "  Note: this log does not measure FPS or prove visual focus."
}

print_settings_status() {
  [[ -f "$STATE" ]] || { print -- "Settings profile: not recorded"; return 0; }
  local recorded_choice recorded_profile settings_path applied_sha
  recorded_choice="$(state_value settings_choice "$STATE")"
  recorded_profile="$(state_value settings_profile "$STATE")"
  if [[ "$recorded_choice" != apply ]]; then
    print -- "Settings profile: unchanged by patcher"
    return 0
  fi
  [[ -n "$recorded_profile" ]] || recorded_profile="legacy-applied-profile"
  if [[ ! -f "$SETTINGS_PATH_FILE" || ! -f "$SETTINGS_APPLIED_SHA_FILE" ]]; then
    print -- "Settings profile: $recorded_profile (restore record incomplete)"
    return 0
  fi
  settings_path="$(<"$SETTINGS_PATH_FILE")"
  applied_sha="$(<"$SETTINGS_APPLIED_SHA_FILE")"
  if [[ -f "$settings_path" && "$(sha256 "$settings_path")" == "$applied_sha" ]]; then
    print -- "Settings profile: $recorded_profile (applied)"
  else
    print -- "Settings profile: $recorded_profile (customized after install; preserved)"
  fi
}

check() {
  ui_clear
  ui_header "Installation status"
  resolve_target; state_directory
  require_supported_executable
  local overall="READY" patch_state="unknown" marker_sha="" \
    recorded_executable="" recorded_original="" marker_mode="" \
    installed_version=""
  if [[ -e "$MARKER" ]]; then
    if [[ "$(sha256 "$BINK")" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]]; then
      marker_sha="$(sed -n 's/^eso_sha256=//p' "$MARKER" | head -1)"
      if [[ "$marker_sha" == "$ACTUAL_ESO_SHA256" ]]; then
        patch_state=installed
        [[ -f "$VERSION_FILE" ]] && installed_version="$(<"$VERSION_FILE")"
        if [[ "$installed_version" == "${RELEASE_VERSION:-unknown}" ]]; then
          print -- "Supported ESO client; patch installed."
        else
          print -- "Supported ESO client; verified bridge installed with an earlier package state. Re-run Install to upgrade."
          overall="UPGRADE AVAILABLE"
        fi
        [[ -n "$installed_version" ]] && print -- "Installed release: $installed_version"
      else
        print -- "Supported ESO client; update left the bridge installed with a stale attestation."
        print -- "Run the ESO launcher Repair before Install or Uninstall; the previous original backup must not be restored across generations."
        patch_state=stale
        overall="ACTION REQUIRED"
      fi
    elif [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
      print -- "Supported ESO client; update restored the original loader. Re-run Install."
      patch_state=not-installed
      overall="ACTION REQUIRED"
    else
      if [[ "$(active_loader_kind)" == bridge ]]; then
        marker_sha="$(state_value eso_sha256 "$MARKER")"
        recorded_executable="$(state_value executable_sha256 "$STATE" 2>/dev/null || true)"
        recorded_original="$(state_value original_bink_sha256 "$STATE" 2>/dev/null || true)"
        if [[ -f "$STATE" && -f "$BACKUP" \
          && ( "$marker_sha" == "$ACTUAL_ESO_SHA256" \
            || ( -z "$marker_sha" && "$ACTUAL_ESO_SHA256" == "$EXPECTED_ESO_SHA256" \
              && "$(marker_mode_value || true)" == startup-compositor-neutralize-pacing-release ) ) \
          && "$recorded_executable" == "$ACTUAL_ESO_SHA256" \
          && "$recorded_original" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
          && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
          print -- "Supported ESO client; verified earlier patcher installed. Re-run Install to upgrade."
          patch_state=earlier-installed
          overall="UPGRADE AVAILABLE"
          [[ -f "$VERSION_FILE" ]] && print -- "Installed release: $(<"$VERSION_FILE")"
        else
          die "Incomplete patch state: an unrecognized bridge is active. Run the ESO launcher Repair. No files were changed."
        fi
      else
        print -- "Patch not active; ESO has a different original-loader generation."
        print -- "This release will preserve that loader. Use a newer compatible patcher before reinstalling."
        patch_state=unsupported-original
        overall="ACTION REQUIRED"
      fi
    fi
  else
    if [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
      print -- "Supported ESO client; patch not installed."
      patch_state=not-installed
      overall="NOT INSTALLED"
    elif [[ "$(active_loader_kind)" == bridge ]]; then
      die "Unsupported or already-modified bridge loader. No files were changed."
    else
      print -- "Patch not installed; the active original loader belongs to a different generation."
      print -- "This release will not overwrite it."
      patch_state=unsupported-original
      overall="ACTION REQUIRED"
    fi
  fi
  if [[ "$patch_state" == installed || "$patch_state" == earlier-installed ]]; then
    recorded_original="$(state_value original_bink_sha256 "$STATE" 2>/dev/null || true)"
    marker_mode="$(marker_mode_value || true)"
    if [[ -f "$BACKUP" && -f "$STATE" \
      && "$recorded_original" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
      && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
      print -- "Recovery: verified"
    else
      print -- "Recovery: INVALID or incomplete"
      overall="ACTION REQUIRED"
    fi
    if [[ -f "$MVK" && "$(sha256 "$MVK")" == "$(sha256 "$PAYLOAD/libMoltenVK.teso4m4.dylib")" \
      && "$marker_mode" == startup-compositor-neutralize-pacing-release ]]; then
      print -- "Runtime profile: startup-compositor-neutralize-pacing-release"
    else
      print -- "Runtime profile: INVALID or incomplete"
      overall="ACTION REQUIRED"
    fi
  else
    print -- "Recovery: not required for current state"
  fi
  print_settings_status
  print -- "Overall: $overall"
  print -- "Compatibility: $TARGET_COMPATIBILITY"
  print -- "Location: $ESO_APP"
  print -- "Production log: $PRODUCTION_LOG"
  print_latest_run_summary
}

write_filtered_latest_run() {
  local destination="$1" run_id=""
  run_id="$(latest_run_id || true)"
  if [[ -z "$run_id" ]]; then
    print -- "No production bridge run is available." > "$destination"
    return 0
  fi
  grep -F "[run=$run_id]" "$PRODUCTION_LOG" | grep -E \
    '\] (RUN_START:|MODE:|MOLTENVK_CONFIG:|INACTIVE_PACING_ACTIVE:|INACTIVE_PACING_STATE:|ACTIVE:|ESO SHA-256:|STARTUP_COMPOSITOR_NEUTRALIZE_BEGIN:|STARTUP_COMPOSITOR_NEUTRALIZE_LATCH:|STARTUP_COLOR_AUDIT_FINISH:|ERROR:|FATAL:|SKIP:|[^ ]+_ERROR:)' \
    | sed -E -e "s|$HOME|<HOME>|g" -e "s|$ESO_APP|<ESO_APP>|g" \
      -e 's/ pipeline=[^ ]+ descriptor_update_signature=[^ ]+//' \
    > "$destination" || true
}

diagnose() {
  local timestamp report_root report_dir raw_report output parent original_ui_tty
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  output="${support_output:-$HOME/Desktop/ESO-MoltenVK-Patcher-Support-$timestamp.zip}"
  output="${output:A}"
  parent="${output:h}"
  [[ -d "$parent" ]] || die "The support report destination does not exist: $parent"
  [[ ! -e "$output" ]] || die "The support report already exists: $output"
  report_root="$(mktemp -d /private/tmp/eso-moltenvk-support.XXXXXX)"
  report_dir="$report_root/ESO-MoltenVK-Patcher-Support"
  mkdir -m 700 "$report_dir"
  raw_report="$report_root/status.raw"
  original_ui_tty="$UI_TTY"
  UI_TTY=false
  check > "$raw_report"
  UI_TTY="$original_ui_tty"
  sed -e "s|$HOME|<HOME>|g" -e "s|$ESO_APP|<ESO_APP>|g" \
    -e "s|$STATE_DIR|<STATE_DIR>|g" -e "s|$PRODUCTION_LOG|<PRODUCTION_LOG>|g" \
    "$raw_report" \
    > "$report_dir/report.txt"
  {
    print -- "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    print -- "Patcher package: ${RELEASE_VERSION:-unknown}"
    print -- "Hardware architecture: $(uname -m)"
    if command -v sw_vers >/dev/null 2>&1; then
      print -- "macOS: $(sw_vers -productVersion)"
    fi
    print -- "ESO SHA-256: $ACTUAL_ESO_SHA256"
    print -- "Bridge SHA-256: $(sha256 "$BINK")"
    [[ -f "$MVK" ]] && print -- "MoltenVK SHA-256: $(sha256 "$MVK")"
  } > "$report_dir/checksums.txt"
  write_filtered_latest_run "$report_dir/latest-run.log"
  chmod 600 "$report_dir"/*
  (cd "$report_root" && COPYFILE_DISABLE=1 zip -q -r -X "$output" "${report_dir:t}")
  chmod 600 "$output"
  rm -f "$raw_report" "$report_dir/report.txt" "$report_dir/checksums.txt" \
    "$report_dir/latest-run.log"
  rmdir "$report_dir" "$report_root"
  print -- "Privacy-filtered support report created: $output"
  print -- "It contains no settings file, cache, credentials, proprietary game file, or raw system log."
}

install() {
  ui_plan_start "Safe, reversible runtime installation" \
    "Finding ESO installation" \
    "Verifying supported ESO build" \
    "Checking game, launcher, and update state" \
    "Preparing verified recovery backup" \
    "Installing runtime bridge" \
    "Finalizing settings and verifying installation"
  resolve_target; state_directory
  ui_step 1 6 "Finding ESO installation"
  require_supported_executable
  ui_step 2 6 "Verifying supported ESO build"
  require_idle
  ui_step 3 6 "Checking game, launcher, and update state"
  recover_incomplete_install
  if [[ "$INSTALL_ALREADY_CURRENT" == true ]]; then
    ui_step 4 6 "Preparing verified recovery backup" "Skipped"
    ui_step 5 6 "Installing runtime bridge" "Skipped"
    ui_step 6 6 "Verifying installation" "Done"
    ui_complete "Patch already installed"
    print -- ""
    print -- "  The installed bridge already matches this ESO executable."
    print -- "  No files were changed."
    print -- "  ESO: $ESO_APP"
    return 0
  fi
  [[ "$PATCH_UPGRADE" == true ]] || require_supported_original
  if [[ "$assume_yes" != true ]]; then
    [[ -t 0 && "$UI_TTY" == true ]] \
      || die "Non-interactive installation requires --yes to confirm the ESO target."
    if ! ui_choice_menu \
      "Continue with this ESO installation?" \
      "$ESO_APP" \
      "Install" \
      "Cancel"; then
      print -- ""
      print -- "  Cancelled. No files were changed."
      return 0
    fi
  fi
  choose_settings_action
  resolve_settings_file
  validate_settings_template
  MUTATION_STARTED=true
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  archive_previous_recovery_generation
  if [[ "$PATCH_UPGRADE" == true ]]; then
    copy_verified "$BACKUP" "$BINK"
    [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
      || die "The verified same-generation baseline could not be restored for upgrade."
  fi
  if [[ -e "$BACKUP" || -e "$STATE" ]]; then
    [[ -f "$BACKUP" && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "The existing restore backup is incomplete or does not match this client."
    [[ ! -e "$STATE" || -f "$STATE" ]] || die "The existing restore record is invalid."
  else
    copy_verified "$BINK" "$BACKUP"
  fi
  if [[ "$settings_choice" == skip \
    && "$PREVIOUS_SETTINGS_CHOICE" == apply \
    && -n "$PREVIOUS_SETTINGS_BACKUP" \
    && -f "$STATE_DIR/$PREVIOUS_SETTINGS_BACKUP" \
    && -f "$SETTINGS_PATH_FILE" \
    && -f "$SETTINGS_APPLIED_SHA_FILE" ]]; then
    RETAIN_PREVIOUS_SETTINGS_RECORD=true
  else
    prepare_settings_template
  fi
  preserve_previous_state
  record_state prepared
  ui_step 4 6 "Preparing verified recovery backup"
  copy_verified "$BINK" "$RENAMED"
  retag_original
  copy_verified "$PAYLOAD/libBink2Macx64.dylib" "$BINK"
  copy_verified "$PAYLOAD/libMoltenVK.teso4m4.dylib" "$MVK"
  ui_step 5 6 "Installing runtime bridge"
  [[ -n "${SETTINGS_BACKUP_NAME:-}" ]] && commit_settings_template
  print -r -- 'mode=startup-compositor-neutralize-pacing-release' > "$STATE_DIR/enable-marker"
  print -r -- "eso_sha256=$ACTUAL_ESO_SHA256" >> "$STATE_DIR/enable-marker"
  copy_verified "$STATE_DIR/enable-marker" "$MARKER"
  rm -f "$STATE_DIR/enable-marker"
  record_state installed
  [[ -f "$MARKER" && "$(sha256 "$BINK")" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]] \
    || die "Final installation verification failed."
  if [[ "$settings_choice" == apply ]]; then
    ui_step 6 6 "Applying settings and verifying installation"
  else
    ui_step 6 6 "Verifying installation" "Done"
  fi
  MUTATION_STARTED=false
  ui_complete "Installation complete"
  print -- ""
  print -- "  ESO:      $ESO_APP"
  print -- "  Patcher:  ${RELEASE_VERSION:-unknown}"
  [[ "$settings_choice" == apply ]] \
    && print -- "  Settings: Applied ($SETTINGS_PROFILE_NAME)" \
    || print -- "  Settings: Unchanged"
  print -- "  Backup:   Verified"
  print -- ""
  print -- "  Start ESO through your usual Steam or ZeniMax launcher."
  print -- "  There is no in-game AddOns toggle for this runtime patch."
  print -- ""
  print -- "Installed to: $ESO_APP"
  print -- "Release: ${RELEASE_VERSION:-unknown}"
  print -- "Verified restore backup: $BACKUP"
}

remove_owned_companion_if_exact() {
  local target_file="$1" expected_sha="$2" label="$3"
  [[ -e "$target_file" ]] || return 0
  if [[ -f "$target_file" && "$(sha256 "$target_file")" == "$expected_sha" ]]; then
    write_command "${target_file:h}" rm -f "$target_file"
  else
    print -- "  Preserved unexpected $label at: $target_file"
  fi
}

remove() {
  ui_plan_start "Restore the original ESO runtime" \
    "Finding patched ESO installation" \
    "Checking game, launcher, and recovery state" \
    "Restoring original runtime files" \
    "Verifying settings and removal"
  resolve_target; state_directory
  ui_step 1 4 "Finding patched ESO installation"
  require_idle
  ui_step 2 4 "Checking game, launcher, and recovery state"
  ACTUAL_ESO_SHA256="$(sha256 "$ESO")"
  load_verified_recovery_record
  source "$STATE"
  local current_bink payload_bink marker_sha loader_kind active_before
  current_bink="$(sha256 "$BINK")"
  payload_bink="$(sha256 "$PAYLOAD/libBink2Macx64.dylib")"
  marker_sha=""
  [[ -f "$MARKER" ]] \
    && marker_sha="$(state_value eso_sha256 "$MARKER")"
  active_before="$current_bink"
  if [[ "$current_bink" == "$payload_bink" ]]; then
    [[ "$RECORDED_EXECUTABLE_SHA256" == "$ACTUAL_ESO_SHA256" \
      && "$marker_sha" == "$ACTUAL_ESO_SHA256" ]] \
      || die "ESO changed while the bridge remained active. Run the ESO launcher Repair before Uninstall; the previous original backup was not restored. No files were changed."
    REMOVE_RESTORE_ACTION=verified-backup-restored
  else
    loader_kind="$(active_loader_kind)"
    if [[ "$loader_kind" == bridge ]]; then
      [[ "$RECORDED_EXECUTABLE_SHA256" == "$ACTUAL_ESO_SHA256" \
        && "$RECORDED_ORIGINAL_BINK_SHA256" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
        && "$marker_sha" == "$ACTUAL_ESO_SHA256" ]] \
        || die "An unrecognized bridge loader is active. Run the ESO launcher Repair before Uninstall. No files were changed."
      REMOVE_RESTORE_ACTION=verified-backup-restored
    else
      REMOVE_RESTORE_ACTION=external-original-preserved
    fi
  fi
  MUTATION_STARTED=true
  if [[ "$REMOVE_RESTORE_ACTION" == verified-backup-restored ]]; then
    copy_verified "$BACKUP" "$BINK"
  else
    print -- "  The launcher already replaced the bridge; the active Bink library was left untouched."
  fi
  remove_owned_companion_if_exact \
    "$RENAMED" "$EXPECTED_RETAGGED_ORIGINAL_BINK_SHA256" \
    "renamed original-loader companion"
  remove_owned_companion_if_exact \
    "$MVK" "$(sha256 "$PAYLOAD/libMoltenVK.teso4m4.dylib")" \
    "MoltenVK companion"
  write_command "$GAME_MAC" rm -f "$MARKER"
  ui_step 3 4 "Restoring original runtime files"
  restore_settings_if_safe
  record_state removed
  if [[ "$REMOVE_RESTORE_ACTION" == verified-backup-restored ]]; then
    [[ "$(sha256 "$BINK")" == "$RECORDED_ORIGINAL_BINK_SHA256" ]] \
      || die "Final uninstall verification failed."
  else
    [[ "$(sha256 "$BINK")" == "$active_before" ]] \
      || die "Final uninstall verification failed: the externally restored loader changed."
  fi
  [[ ! -e "$MARKER" ]] || die "Final uninstall verification failed."
  ui_step 4 4 "Verifying settings and removal"
  MUTATION_STARTED=false
  ui_complete "Uninstall complete"
  print -- ""
  print -- "  ESO:      $ESO_APP"
  if [[ "$REMOVE_RESTORE_ACTION" == verified-backup-restored ]]; then
    print -- "  Runtime:  Matching original Bink loader restored"
  else
    print -- "  Runtime:  Launcher-provided Bink loader preserved"
  fi
  print -- "  Backup:   Retained for verification"
  print -- ""
  print -- "Removed from: $ESO_APP"
  print -- "The original Bink library is restored; the verified backup remains at: $BACKUP"
}

case "$command_name" in
  check|status) check ;;
  diagnose) diagnose ;;
  install) install ;;
  remove) remove ;;
  repair)
    requested_settings_choice="$settings_choice"
    remove
    settings_choice="$requested_settings_choice"
    SETTINGS_BACKUP_NAME=""
    install
    ;;
  *) usage; exit 2 ;;
esac
