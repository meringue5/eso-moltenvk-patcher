#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h:h}"
PAYLOAD="$ROOT/payload"
source "$PAYLOAD/target-profile.env"

UI_TTY=false
[[ -t 1 ]] && UI_TTY=true
UI_GREEN="" UI_RED="" UI_BLUE="" UI_DIM="" UI_BRIGHT="" UI_GREY="" UI_RESET=""
if [[ "$UI_TTY" == true && -z "${NO_COLOR:-}" ]]; then
  UI_GREEN=$'\033[32m'
  UI_RED=$'\033[31m'
  UI_BLUE=$'\033[36m'
  UI_DIM=$'\033[2m'
  UI_BRIGHT=$'\033[1m'
  UI_GREY=$'\033[90m'
  UI_RESET=$'\033[0m'
fi
MUTATION_STARTED=false
INSTALL_ALREADY_CURRENT=false
UI_ACTION=""
UI_COMPLETED=0
typeset -a UI_STEP_LABELS

ui_clear() {
  if [[ "$UI_TTY" == true ]]; then
    printf '\033[2J\033[H'
  fi
  return 0
}

ui_header() {
  local action="$1"
  print -- ""
  print -- "╭──────────────────────────────────────────────╮"
  printf '│  %-44s│\n' "ESO MoltenVK Patcher ${RELEASE_VERSION:-unknown}"
  printf '│  %-44s│\n' "$action"
  print -- "╰──────────────────────────────────────────────╯"
  print -- ""
}

ui_step() {
  local current="$1" total="$2" label="$3" result="${4:-Done}"
  if [[ "$UI_TTY" == true && -n "$UI_ACTION" ]]; then
    UI_COMPLETED="$current"
    ui_render_plan
    return 0
  fi
  local symbol="✓" color="$UI_GREEN"
  [[ "$result" == "Skipped" ]] && { symbol="–"; color="$UI_DIM"; }
  print -- "  ${color}${symbol}${UI_RESET} [$current/$total] $label  ${color}$result${UI_RESET}"
}

ui_render_plan() {
  ui_clear
  ui_header "$UI_ACTION"
  local step total="${#UI_STEP_LABELS[@]}"
  for (( step = 1; step <= total; step++ )); do
    if (( step <= UI_COMPLETED )); then
      print -- "  ${UI_GREEN}☑${UI_RESET} ${UI_BRIGHT}[$step/$total] ${UI_STEP_LABELS[$step]}${UI_RESET}"
    else
      print -- "    ${UI_GREY}[$step/$total] ${UI_STEP_LABELS[$step]}${UI_RESET}"
    fi
  done
  print -- ""
}

ui_plan_start() {
  UI_ACTION="$1"
  shift
  UI_STEP_LABELS=("$@")
  UI_COMPLETED=0
  if [[ "$UI_TTY" == true ]]; then
    ui_render_plan
  else
    ui_header "$UI_ACTION"
  fi
}

ui_choice_menu() {
  local title="$1" detail="$2" yes_label="$3" no_label="$4"
  local selected=1 key="" sequence=""
  while true; do
    ui_render_plan
    print -- "  $title"
    [[ -n "$detail" ]] && print -- "  $detail"
    print -- ""
    if (( selected == 1 )); then
      print -- "  ${UI_GREEN}›${UI_RESET} ${UI_BRIGHT}$yes_label${UI_RESET}"
    else
      print -- "    $yes_label"
    fi
    if (( selected == 2 )); then
      print -- "  ${UI_GREEN}›${UI_RESET} ${UI_BRIGHT}$no_label${UI_RESET}"
    else
      print -- "    $no_label"
    fi
    print -- ""
    print -- "  ${UI_DIM}Use ↑/↓ and Return, or press Y/N. Esc cancels.${UI_RESET}"
    if ! IFS= read -rsk1 key; then
      return 1
    fi
    case "$key" in
      y|Y) return 0 ;;
      n|N) return 1 ;;
      $'\n'|$'\r')
        (( selected == 1 )) && return 0
        (( selected == 2 )) && return 1
        printf '\a'
        ;;
      $'\e')
        sequence=""
        IFS= read -rsk2 -t 0.2 sequence || true
        case "$sequence" in
          '[A'|'[B') selected=$(( selected == 1 ? 2 : 1 )) ;;
          *) return 1 ;;
        esac
        ;;
      *) printf '\a' ;;
    esac
  done
}

ui_complete() {
  print -- ""
  print -- "${UI_GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 100%${UI_RESET}"
  print -- ""
  print -- "${UI_GREEN}✓ $1${UI_RESET}"
}

die() {
  print -u2 -- ""
  print -u2 -- "${UI_RED}✗ Operation stopped safely${UI_RESET}"
  print -u2 -- ""
  print -u2 -- "  $*"
  if [[ "$MUTATION_STARTED" == false ]]; then
    [[ "$*" == *"No files were changed."* ]] || print -u2 -- "  No files were changed."
  else
    print -u2 -- "  A verified recovery record is available; run the command again."
  fi
  exit 1
}
sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

usage() {
  cat <<'EOF'
Usage: eso-moltenvk-patcher <status|install|remove|repair> [options]

Install options:
  --apply-settings       selectively merge the bundled M4 settings template
  --skip-settings        leave UserSettings.txt unchanged
  --settings-file PATH   select UserSettings.txt when applying the template
  --yes                  accept the displayed ESO application target

PATH may be eso.app itself or an ESO Launcher.app containing game_mac.
No game, Steam, or launcher is started by this tool.
EOF
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 2; }
shift || true
selected="${ESO_APP:-}"
selected_settings="${ESO_SETTINGS_FILE:-}"
assume_yes=false
settings_choice=""
while (( $# )); do
  case "$1" in
    --eso-app) (( $# >= 2 )) || die "--eso-app needs a path"; selected="$2"; shift 2 ;;
    --settings-file) (( $# >= 2 )) || die "--settings-file needs a path"; selected_settings="$2"; shift 2 ;;
    --apply-settings) [[ -z "$settings_choice" ]] || die "Choose only one settings action."; settings_choice=apply; shift ;;
    --skip-settings) [[ -z "$settings_choice" ]] || die "Choose only one settings action."; settings_choice=skip; shift ;;
    --yes|-y) assume_yes=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown argument: $1" ;;
  esac
done

resolve_target() {
  local home_dir="$HOME"
  local -a candidates=(
    "$home_dir/Library/Application Support/Steam/steamapps/common/Zenimax Online/The Elder Scrolls Online/game_mac/pubplayerclient/eso.app"
    "/Applications/ZeniMax Online/Launcher.app/game_mac/pubplayerclient/eso.app"
  )
  if [[ -z "$selected" ]]; then
    local candidate
    for candidate in "${candidates[@]}"; do
      [[ -d "$candidate" ]] && { selected="$candidate"; break; }
    done
  fi
  if [[ -z "$selected" && -t 0 ]]; then
    print -- "ESO was not found in a known location."
    print -- "Drag eso.app or the ESO Launcher.app into this Terminal window, then press Return:"
    IFS= read -r selected
    selected="${(Q)selected}"
  fi
  [[ -n "$selected" ]] || die "ESO was not found. Re-run with --eso-app '/path/to/eso.app'."
  if [[ "${selected:t}" == "eso.app" ]]; then
    ESO_APP="${selected:A}"
  else
    ESO_APP="${selected:A}/game_mac/pubplayerclient/eso.app"
  fi
  GAME_MAC="$ESO_APP/Contents/MacOS"
  ESO="$GAME_MAC/eso"
  BINK="$GAME_MAC/libBink2Macx64.dylib"
  MARKER="$GAME_MAC/.teso4m4-enable"
  RENAMED="$GAME_MAC/libBink2Macx64.teso4m4-original.dylib"
  MVK="$GAME_MAC/libMoltenVK.teso4m4.dylib"
  LEGACY_MVK="$ESO_APP/Contents/Frameworks/MoltenVK.framework/Versions/A/MoltenVK"
  COMPAT_AUDIT="$PAYLOAD/eso-compat-audit"
  [[ -f "$ESO" && -f "$BINK" ]] || die "This path does not contain an ESO macOS client."
}

state_directory() {
  local id
  id="$(print -rn -- "$ESO_APP" | shasum -a 256 | awk '{print $1}')"
  local state_root="${ESO_MOLTENVK_PATCHER_STATE_ROOT:-$HOME/Library/Application Support/ESO MoltenVK Patcher/Installations}"
  STATE_DIR="$state_root/$id"
  BACKUP="$STATE_DIR/original-libBink2Macx64.dylib"
  STATE="$STATE_DIR/install-state.env"
  VERSION_FILE="$STATE_DIR/.version"
  SETTINGS_PATH_FILE="$STATE_DIR/settings-target-path.txt"
  SETTINGS_APPLIED_SHA_FILE="$STATE_DIR/settings-applied.sha256"
}

choose_settings_action() {
  [[ "$command_name" == install || "$command_name" == repair ]] || return 0
  if [[ -n "$settings_choice" ]]; then return 0; fi
  [[ -t 0 ]] || die "Choose settings explicitly with --apply-settings or --skip-settings."
  if ui_choice_menu \
    "Settings profile" \
    "Validated M4 2048 x 1280 profile; Apply is selected by default." \
    "Apply 48 allowlisted settings" \
    "Keep my current settings"; then
    settings_choice=apply
  else
    settings_choice=skip
  fi
}

resolve_settings_file() {
  [[ "$settings_choice" == apply ]] || return 0
  local home_dir="$HOME"
  local -a candidates=(
    "$home_dir/Documents/Elder Scrolls Online/live/UserSettings.txt"
    "$home_dir/Library/Mobile Documents/com~apple~CloudDocs/Documents/Elder Scrolls Online/live/UserSettings.txt"
  )
  if [[ -z "$selected_settings" ]]; then
    local candidate
    for candidate in "${candidates[@]}"; do
      [[ -f "$candidate" ]] && { selected_settings="$candidate"; break; }
    done
  fi
  if [[ -z "$selected_settings" && -t 0 ]]; then
    print -- "UserSettings.txt was not found in a known location."
    print -- "Drag UserSettings.txt into this Terminal window, then press Return:"
    IFS= read -r selected_settings
    selected_settings="${(Q)selected_settings}"
  fi
  [[ -n "$selected_settings" ]] || die "UserSettings.txt was not found. Re-run with --settings-file PATH."
  SETTINGS_FILE="${selected_settings:A}"
  [[ -f "$SETTINGS_FILE" ]] || die "The selected settings path is not a regular file: $SETTINGS_FILE"
  [[ -f "$PAYLOAD/usersettings-m4-moltenvk-1.4.2-standard.txt" ]] || die "The settings template is missing from this release."
}

validate_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local template="$PAYLOAD/usersettings-m4-moltenvk-1.4.2-standard.txt"
  local count unique
  count="$(awk '$1 == "SET" {count++} END {print count + 0}' "$template")"
  unique="$(awk '$1 == "SET" {seen[$2] = 1} END {for (key in seen) count++; print count + 0}' "$template")"
  [[ "$count" == 48 && "$unique" == 48 ]] || die "The bundled settings template is not the expected 48-key profile."
}

prepare_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local template="$PAYLOAD/usersettings-m4-moltenvk-1.4.2-standard.txt"
  local backup temporary
  backup="$(mktemp "$STATE_DIR/settings-backup-XXXXXXXX")"
  temporary="$STATE_DIR/settings-merged.txt"
  copy_verified "$SETTINGS_FILE" "$backup"
  awk '
    NR == FNR {
      if ($1 == "SET") { replacement[$2] = $0; order[++count] = $2 }
      next
    }
    {
      if ($1 == "SET" && ($2 in replacement)) {
        print replacement[$2]
        applied[$2] = 1
      } else print
    }
    END {
      for (item_index = 1; item_index <= count; item_index++) {
        key = order[item_index]
        if (!(key in applied)) print replacement[key]
      }
    }
  ' "$template" "$SETTINGS_FILE" > "$temporary"
  if ! awk '$1 == "SET" {seen[$2]++} END {for (key in seen) if (seen[key] != 1) exit 1}' "$temporary"; then
    rm -f "$temporary"
    die "The merged settings file contains duplicate keys."
  fi
  print -r -- "$SETTINGS_FILE" > "$SETTINGS_PATH_FILE"
  rm -f "$SETTINGS_APPLIED_SHA_FILE"
  SETTINGS_BACKUP_NAME="${backup:t}"
}

commit_settings_template() {
  [[ "$settings_choice" == apply ]] || return 0
  local merged="$STATE_DIR/settings-merged.txt"
  [[ -f "$merged" ]] || die "The prepared settings merge is missing."
  copy_verified "$merged" "$SETTINGS_FILE"
  print -r -- "$(sha256 "$SETTINGS_FILE")" > "$SETTINGS_APPLIED_SHA_FILE"
  rm -f "$merged"
}

restore_settings_if_safe() {
  [[ "${settings_choice:-skip}" == apply ]] || return 0
  [[ -f "$SETTINGS_APPLIED_SHA_FILE" ]] || return 0
  [[ -f "$SETTINGS_PATH_FILE" && -n "${settings_backup:-}" ]] \
    || { print -- "Settings restore record is incomplete; settings were not changed."; return 0; }
  local settings_file backup applied_sha
  settings_file="$(<"$SETTINGS_PATH_FILE")"
  backup="$STATE_DIR/$settings_backup"
  applied_sha="$(<"$SETTINGS_APPLIED_SHA_FILE")"
  [[ -f "$settings_file" && -f "$backup" ]] || { print -- "Settings file or backup is missing; settings were not changed."; return 0; }
  if [[ "$(sha256 "$settings_file")" != "$applied_sha" ]]; then
    print -- "Settings changed after installation; they were not overwritten. Backup retained at: $backup"
    return 0
  fi
  copy_verified "$backup" "$settings_file"
  print -- "Restored pre-install settings from: $backup"
}

require_supported_original() {
  [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "The Bink library is not the exact original expected by this release. No files were changed."
}

require_supported_executable() {
  ACTUAL_ESO_SHA256="$(sha256 "$ESO")"
  TARGET_COMPATIBILITY=exact
  if [[ "$ACTUAL_ESO_SHA256" == "$EXPECTED_ESO_SHA256" ]]; then
    return 0
  fi
  [[ -f "$LEGACY_MVK" ]] || die "The embedded MoltenVK archive is missing. No files were changed."
  [[ "$(sha256 "$LEGACY_MVK")" == "$EXPECTED_LEGACY_MVK_ARCHIVE_SHA256" ]] \
    || die "ESO's embedded MoltenVK changed. No files were changed."
  [[ -x "$COMPAT_AUDIT" ]] || die "The compatibility auditor is missing from this release. No files were changed."
  "$COMPAT_AUDIT" "$ESO" >/dev/null 2>&1 \
    || die "ESO's MoltenVK call layout changed. No files were changed."
  TARGET_COMPATIBILITY=compatible-update
  print -- "  Compatible ESO update detected; the MoltenVK bridge profile is unchanged."
}

require_idle() {
  pgrep -x eso >/dev/null 2>&1 && die "Quit ESO before changing its files."
  pgrep -f '/ZeniMax Online Studios Launcher' >/dev/null 2>&1 && die "Quit the ZeniMax launcher before changing ESO files."
  command -v lsof >/dev/null 2>&1 || die "lsof is required to check that the ESO bundle is idle."
  local open_files="" lsof_status=0
  open_files="$(lsof -Fn +D "$ESO_APP" 2>/dev/null)" || lsof_status=$?
  [[ -z "$open_files" && "$lsof_status" -eq 1 ]] || die "A process is using this ESO bundle, or its idle state could not be verified."
  local marker="/steamapps/common/"
  [[ "$ESO_APP" == *"$marker"* ]] || return 0
  local steamapps="${ESO_APP%%$marker*}/steamapps"
  local manifest="$steamapps/appmanifest_306130.acf"
  [[ -f "$manifest" ]] || return 0
  local flags total done
  flags="$(awk -F'"' '$2 == "StateFlags" {print $4; exit}' "$manifest")"
  total="$(awk -F'"' '$2 == "BytesToDownload" {print $4; exit}' "$manifest")"
  done="$(awk -F'"' '$2 == "BytesDownloaded" {print $4; exit}' "$manifest")"
  [[ "$flags" == "4" && -n "$total" && "$total" == "$done" ]] || die "Steam reports ESO as updating or incomplete."
  [[ ! -d "$steamapps/downloading/306130" || -z "$(find "$steamapps/downloading/306130" -mindepth 1 -print -quit 2>/dev/null)" ]] || die "Steam has staged ESO download content."
}

write_command() {
  local directory="$1"
  shift
  if [[ -w "$directory" ]]; then "$@"; else sudo "$@"; fi
}

copy_verified() {
  local source="$1" destination="$2" temporary="${2}.eso-moltenvk-patcher-installing"
  write_command "${temporary:h}" rm -f "$temporary"
  write_command "${temporary:h}" cp -p "$source" "$temporary"
  [[ "$(sha256 "$source")" == "$(sha256 "$temporary")" ]] || die "Copy verification failed for ${destination:t}."
  write_command "${destination:h}" rm -f "$destination"
  write_command "${destination:h}" mv "$temporary" "$destination"
}

retag_original() {
  write_command "${RENAMED:h}" /usr/bin/install_name_tool -id \
    '@loader_path/libBink2Macx64.teso4m4-original.dylib' "$RENAMED"
}

record_state() {
  local phase="$1"
  print -r -- "executable_sha256=${ACTUAL_ESO_SHA256:-$(sha256 "$ESO")}" > "$STATE"
  print -r -- "profile_sha256=$EXPECTED_ESO_SHA256" >> "$STATE"
  print -r -- "original_bink_sha256=$EXPECTED_ORIGINAL_BINK_SHA256" >> "$STATE"
  print -r -- "release_version=${RELEASE_VERSION:-unknown}" >> "$STATE"
  print -r -- "transaction_phase=$phase" >> "$STATE"
  print -r -- "settings_choice=${settings_choice:-skip}" >> "$STATE"
  print -r -- "settings_backup=${SETTINGS_BACKUP_NAME:-${settings_backup:-}}" >> "$STATE"
  print -r -- "recorded_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$STATE"
  print -r -- "${RELEASE_VERSION:-unknown}" > "$VERSION_FILE"
}

preserve_previous_state() {
  [[ -f "$STATE" ]] || return 0
  local recorded_sha
  recorded_sha="$(sed -n 's/^executable_sha256=//p' "$STATE" | head -1)"
  [[ -n "$recorded_sha" && "$recorded_sha" != "$ACTUAL_ESO_SHA256" ]] || return 0
  local archived="$STATE_DIR/install-state.before-${recorded_sha[1,12]}.env"
  [[ -e "$archived" ]] || copy_verified "$STATE" "$archived"
  if [[ -f "$MARKER" ]]; then
    local marker_archive="$STATE_DIR/enable-marker.before-${recorded_sha[1,12]}"
    [[ -e "$marker_archive" ]] || copy_verified "$MARKER" "$marker_archive"
  fi
}

recover_incomplete_install() {
  local current_bink="$(sha256 "$BINK")"
  local payload_bink="$(sha256 "$PAYLOAD/libBink2Macx64.dylib")"
  if [[ -e "$MARKER" && "$current_bink" == "$payload_bink" ]]; then
    [[ -f "$BACKUP" && -f "$STATE" \
      && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
      || die "The updated active state has no verified restore record. No files were changed."
    local recorded_sha recorded_original
    recorded_sha="$(sed -n 's/^executable_sha256=//p' "$STATE" | head -1)"
    recorded_original="$(sed -n 's/^original_bink_sha256=//p' "$STATE" | head -1)"
    [[ "$recorded_original" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
      || die "The updated active state has an invalid restore record. No files were changed."
    if [[ "$recorded_sha" == "$ACTUAL_ESO_SHA256" ]]; then
      INSTALL_ALREADY_CURRENT=true
      return 0
    fi
    print -- "  Detected an ESO update that left the bridge loader installed; restoring the verified baseline."
    copy_verified "$BACKUP" "$BINK"
    current_bink="$EXPECTED_ORIGINAL_BINK_SHA256"
  fi
  if [[ -e "$MARKER" && "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
    if [[ -e "$BACKUP" || -e "$STATE" ]]; then
      [[ -f "$BACKUP" && -f "$STATE" \
        && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
        || die "The updated inactive state has no verified restore record. No files were changed."
    fi
    print -- "  Detected an ESO update that restored the original loader; preserving recovery state."
    return 0
  fi
  [[ ! -e "$MARKER" ]] || die "The patch is already installed. Use status or remove."
  if [[ ! -e "$RENAMED" && ! -e "$MVK" && "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
    return 0
  fi
  if [[ "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" && ! -e "$STATE" && ! -e "$BACKUP" ]]; then
    [[ ! -e "$RENAMED" || "$(sha256 "$RENAMED")" == "$EXPECTED_RETAGGED_ORIGINAL_BINK_SHA256" ]] \
      || die "An unknown inactive Bink companion file is present. No files were changed."
    [[ ! -e "$MVK" || "$(sha256 "$MVK")" == "$(sha256 "$PAYLOAD/libMoltenVK.teso4m4.dylib")" ]] \
      || die "An unknown inactive MoltenVK companion file is present. No files were changed."
    print -- "  Detected verified inactive development artifacts; the active original baseline is clean."
    return 0
  fi
  [[ -f "$BACKUP" && -f "$STATE" ]] || die "An incomplete patch state exists without a verified restore record. No files were changed."
  local requested_settings_choice="$settings_choice"
  source "$STATE"
  [[ "${executable_sha256:-}" == "${ACTUAL_ESO_SHA256:-$(sha256 "$ESO")}" \
    && "${original_bink_sha256:-}" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
    && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] \
    || die "The incomplete patch state does not match this exact client. No files were changed."
  [[ "$current_bink" == "$EXPECTED_ORIGINAL_BINK_SHA256" \
    || "$current_bink" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]] \
    || die "The active Bink library is neither the verified original nor this release's bridge. No files were changed."
  print -- "A previous install stopped during phase: ${transaction_phase:-unknown}."
  print -- "Restoring the verified baseline before restarting installation."
  copy_verified "$BACKUP" "$BINK"
  write_command "$GAME_MAC" rm -f "$RENAMED" "$MVK" "$MARKER"
  restore_settings_if_safe
  rm -f "$STATE_DIR/settings-merged.txt" "$SETTINGS_APPLIED_SHA_FILE"
  settings_choice="$requested_settings_choice"
  SETTINGS_BACKUP_NAME=""
  record_state recovered
}

check() {
  ui_clear
  ui_header "Installation status"
  resolve_target; state_directory
  require_supported_executable
  if [[ -e "$MARKER" ]]; then
    if [[ "$(sha256 "$BINK")" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]]; then
      local marker_sha
      marker_sha="$(sed -n 's/^eso_sha256=//p' "$MARKER" | head -1)"
      if [[ "$marker_sha" == "$ACTUAL_ESO_SHA256" ]]; then
        print -- "Supported ESO client; patch installed."
        [[ -f "$VERSION_FILE" ]] && print -- "Installed release: $(<"$VERSION_FILE")"
      else
        print -- "Supported ESO client; update left a stale bridge attestation. Re-run Install."
      fi
    elif [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]]; then
      print -- "Supported ESO client; update restored the original loader. Re-run Install."
    else
      die "Incomplete patch state: marker and loader differ. No files were changed."
    fi
  else
    [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "Unsupported or already-modified Bink library."
    print -- "Supported ESO client; patch not installed."
  fi
  print -- "Compatibility: $TARGET_COMPATIBILITY"
  print -- "Location: $ESO_APP"
}

install() {
  ui_plan_start "Safe, reversible runtime installation" \
    "Finding ESO installation" \
    "Verifying supported ESO build" \
    "Checking game, launcher, and update state" \
    "Preparing verified recovery backup" \
    "Installing runtime bridge" \
    "Finalizing settings and verifying installation"
  resolve_target; state_directory
  ui_step 1 6 "Finding ESO installation"
  require_supported_executable
  ui_step 2 6 "Verifying supported ESO build"
  require_idle
  ui_step 3 6 "Checking game, launcher, and update state"
  recover_incomplete_install
  if [[ "$INSTALL_ALREADY_CURRENT" == true ]]; then
    ui_step 4 6 "Preparing verified recovery backup" "Skipped"
    ui_step 5 6 "Installing runtime bridge" "Skipped"
    ui_step 6 6 "Verifying installation" "Done"
    ui_complete "Patch already installed"
    print -- ""
    print -- "  The installed bridge already matches this ESO executable."
    print -- "  No files were changed."
    print -- "  ESO: $ESO_APP"
    return 0
  fi
  require_supported_original
  if [[ "$assume_yes" != true ]]; then
    [[ -t 0 && "$UI_TTY" == true ]] \
      || die "Non-interactive installation requires --yes to confirm the ESO target."
    if ! ui_choice_menu \
      "Continue with this ESO installation?" \
      "$ESO_APP" \
      "Install" \
      "Cancel"; then
      print -- ""
      print -- "  Cancelled. No files were changed."
      return 0
    fi
  fi
  choose_settings_action
  resolve_settings_file
  validate_settings_template
  MUTATION_STARTED=true
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  if [[ -e "$BACKUP" || -e "$STATE" ]]; then
    [[ -f "$BACKUP" && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "The existing restore backup is incomplete or does not match this client."
    [[ ! -e "$STATE" || -f "$STATE" ]] || die "The existing restore record is invalid."
  else
    copy_verified "$BINK" "$BACKUP"
  fi
  prepare_settings_template
  preserve_previous_state
  record_state prepared
  ui_step 4 6 "Preparing verified recovery backup"
  copy_verified "$BINK" "$RENAMED"
  retag_original
  copy_verified "$PAYLOAD/libBink2Macx64.dylib" "$BINK"
  copy_verified "$PAYLOAD/libMoltenVK.teso4m4.dylib" "$MVK"
  ui_step 5 6 "Installing runtime bridge"
  commit_settings_template
  print -r -- 'mode=startup-compositor-neutralize' > "$STATE_DIR/enable-marker"
  print -r -- "eso_sha256=$ACTUAL_ESO_SHA256" >> "$STATE_DIR/enable-marker"
  copy_verified "$STATE_DIR/enable-marker" "$MARKER"
  rm -f "$STATE_DIR/enable-marker"
  record_state installed
  [[ -f "$MARKER" && "$(sha256 "$BINK")" == "$(sha256 "$PAYLOAD/libBink2Macx64.dylib")" ]] \
    || die "Final installation verification failed."
  if [[ "$settings_choice" == apply ]]; then
    ui_step 6 6 "Applying settings and verifying installation"
  else
    ui_step 6 6 "Verifying installation" "Done"
  fi
  MUTATION_STARTED=false
  ui_complete "Installation complete"
  print -- ""
  print -- "  ESO:      $ESO_APP"
  print -- "  Patcher:  ${RELEASE_VERSION:-unknown}"
  [[ "$settings_choice" == apply ]] \
    && print -- "  Settings: Applied (48-key M4 profile)" \
    || print -- "  Settings: Unchanged"
  print -- "  Backup:   Verified"
  print -- ""
  print -- "  Start ESO through your usual Steam or ZeniMax launcher."
  print -- "  There is no in-game AddOns toggle for this runtime patch."
  print -- ""
  print -- "Installed to: $ESO_APP"
  print -- "Release: ${RELEASE_VERSION:-unknown}"
  print -- "Verified restore backup: $BACKUP"
}

remove() {
  ui_plan_start "Restore the original ESO runtime" \
    "Finding patched ESO installation" \
    "Checking game, launcher, and recovery state" \
    "Restoring original runtime files" \
    "Verifying settings and removal"
  resolve_target; state_directory
  ui_step 1 4 "Finding patched ESO installation"
  require_idle
  ui_step 2 4 "Checking game, launcher, and recovery state"
  [[ -f "$BACKUP" && -f "$STATE" ]] || die "A verified restore record was not found. No files were changed."
  source "$STATE"
  [[ -n "${executable_sha256:-}" && "$(sha256 "$ESO")" == "$executable_sha256" ]] || die "The selected ESO executable changed. No files were changed."
  [[ "${original_bink_sha256:-}" == "$EXPECTED_ORIGINAL_BINK_SHA256" && "$(sha256 "$BACKUP")" == "$EXPECTED_ORIGINAL_BINK_SHA256" ]] || die "The restore backup does not match the supported original."
  MUTATION_STARTED=true
  copy_verified "$BACKUP" "$BINK"
  write_command "$GAME_MAC" rm -f "$RENAMED" "$MVK" "$MARKER"
  ui_step 3 4 "Restoring original runtime files"
  restore_settings_if_safe
  record_state removed
  [[ "$(sha256 "$BINK")" == "$EXPECTED_ORIGINAL_BINK_SHA256" && ! -e "$MARKER" ]] \
    || die "Final uninstall verification failed."
  ui_step 4 4 "Verifying settings and removal"
  MUTATION_STARTED=false
  ui_complete "Uninstall complete"
  print -- ""
  print -- "  ESO:      $ESO_APP"
  print -- "  Runtime:  Original Bink loader restored"
  print -- "  Backup:   Retained for verification"
  print -- ""
  print -- "Removed from: $ESO_APP"
  print -- "The original Bink library is restored; the verified backup remains at: $BACKUP"
}

case "$command_name" in
  check|status) check ;;
  install) install ;;
  remove) remove ;;
  repair)
    requested_settings_choice="$settings_choice"
    remove
    settings_choice="$requested_settings_choice"
    SETTINGS_BACKUP_NAME=""
    install
    ;;
  *) usage; exit 2 ;;
esac
